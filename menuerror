#include <iostream>
using namespace std;

const int MAX = 100;
const int MAX_MATRIZ = 20;
const int LIMITE_DIGITOS = 9999;  // Máximo 4 dígitos

// ============================================
// PROCEDIMIENTOS DE VALIDACIÓN
// ============================================

// Procedimiento para limpiar el buffer de entrada
void limpiarBuffer() {
    cin.clear();
    cin.ignore(10000, '\n');
}

// Función para validar que la entrada sea un número entero
int leerEntero(const char* mensaje) {
    int valor;
    while (true) {
        cout << mensaje;
        if (cin >> valor) {
            // Verificar si el número tiene más de 4 dígitos
            if (valor > LIMITE_DIGITOS || valor < -LIMITE_DIGITOS) {
                cout << "\n*** ERROR: El numero no puede tener mas de 4 digitos ***" << endl;
                cout << "*** El valor maximo permitido es " << LIMITE_DIGITOS << " ***\n" << endl;
                limpiarBuffer();
            } else {
                limpiarBuffer();
                return valor;
            }
        } else {
            cout << "\n*** ERROR: Debe ingresar un numero entero valido ***" << endl;
            cout << "*** No se permiten letras ni caracteres especiales ***\n" << endl;
            limpiarBuffer();
        }
    }
}

// Función para validar que la entrada sea un número positivo
int leerEnteroPositivo(const char* mensaje) {
    int valor;
    while (true) {
        valor = leerEntero(mensaje);
        if (valor > 0) {
            return valor;
        } else {
            cout << "\n*** ERROR: El numero debe ser mayor que cero ***\n" << endl;
        }
    }
}

// ============================================
// PROCEDIMIENTOS DEL MENÚ
// ============================================

// Procedimiento para mostrar el menú principal
void mostrarMenu() {
    cout << "\n========================================" << endl;
    cout << "         MENU PRINCIPAL - C++           " << endl;
    cout << "========================================" << endl;
    cout << "  1. Serie Aritmetica en Vector         " << endl;
